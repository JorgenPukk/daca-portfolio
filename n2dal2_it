Minu päring:
SELECT SUM(KOOPIATE_ARV - 1) AS duplikaadid
FROM (
    SELECT COUNT(*) AS KOOPIATE_ARV
    FROM customers
    GROUP BY email
    HAVING COUNT(*) > 1
) AS duplikaatide_arv;

